  manualEntries:
  - id: walker
    description: A steady close-range threat. Never let a group reach the station
      unchecked.
    visual: {fileID: 6797759080110951857, guid: e477da5b37dc0984daa8b7465a82feb7, type: 3}
    enemy: {fileID: 11400000, guid: dc4a388c3bd39f44e8b302cd9756ec4a, type: 2}
    weapon: {fileID: 0}
    inCurrentWaves: 1
  - id: bloater
    description: A heavy shambler. Use open lanes to keep distance and aim for the
      head.
    visual: {fileID: 1026882827721392806, guid: 729094bffe4bec84ba2bd7a4a5fa2aa0, type: 3}
    enemy: {fileID: 11400000, guid: b5f14f69107eef74388c1031e8dea703, type: 2}
    weapon: {fileID: 0}
    inCurrentWaves: 1
  - id: runner
    description: A fast pursuer. Track your flanks and avoid reloading in the open.
    visual: {fileID: 6458041249744934156, guid: c6325268413212d4a84710f894df13f9, type: 3}
    enemy: {fileID: 11400000, guid: 980f54775413bc049ba257bccfd9b6b9, type: 2}
    weapon: {fileID: 0}
    inCurrentWaves: 1
  - id: skinless
    description: An exposed infected. Keep moving and exploit its headshot multiplier.
    visual: {fileID: 7779243225097284766, guid: 0683b92e42a6566488d3a1d74ebf88fd, type: 3}
    enemy: {fileID: 11400000, guid: 53657501f0b8a3a41a21d7ace0ff773d, type: 2}
    weapon: {fileID: 0}
    inCurrentWaves: 1
  - id: boss_v1
    description: The final-wave heavy. One enters through each gate. Enrages as its
      health drops.
    visual: {fileID: 6093955095576437743, guid: 9b7565b735a540843ad7728753cf8610, type: 3}
    enemy: {fileID: 11400000, guid: 19edce8933f16c34a966a1b43681ba48, type: 2}
    weapon: {fileID: 0}
    inCurrentWaves: 1
  - id: boss_v2
    description: An alternate heavy variant in the catalog. Not selected by the current
      wave director.
    visual: {fileID: 265036643593162914, guid: e8f10aa20cea40c40a723ac6803efa6e, type: 3}
    enemy: {fileID: 11400000, guid: fb8c50cb88b152a4b872b5a0cf19cd81, type: 2}
    weapon: {fileID: 0}
    inCurrentWaves: 0
  - id: boss_v3
